# =============================================================================
# Sistema de Predicción de Incendios Forestales — .gitignore
# =============================================================================

# ─── Entornos Python / Conda ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
conda-env/
.conda/

# ─── Distribución / Packaging ─────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST

# ─── Jupyter Notebooks ────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb_checkpoints/
profile_default/
ipython_config.py

# ─── Testing ──────────────────────────────────────────────────────────────────
.tox/
.pytest_cache/
.coverage
htmlcov/
.cache
nosetests.xml
coverage.xml
*.cover
*.log

# ─── Type Checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ─── Linters / Formatters ─────────────────────────────────────────────────────
.ruff_cache/

# ─── IDEs y Editores ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Variables de entorno / Secretos ─────────────────────────────────────────
.env
.env.local
.env.*.local
deploy/deploy.env
*.pem
*.key
secrets/

# ─── Datos pesados — NO subir al repositorio ─────────────────────────────────
# Regla general: los datos se gestionan localmente o en almacenamiento externo.
# Usar DVC o documentar en docs/ dónde descargarlos.

# Formatos geoespaciales / raster
# NetCDF (ERA5, Copernicus)
*.nc
# Cubo histórico local de comparación
/galicia_wildfire_datacube.nc
*.nc4
*.hdf
*.h5
*.grib
*.grib2
*.tif
*.tiff
*.geotiff
*.img
# GeoPackage (CORINE Land Cover, etc.)
*.gpkg


# Formatos vectoriales grandes
data/raw/*.shp
data/raw/*.shx
data/raw/*.dbf
data/raw/*.prj
data/raw/*.cpg
data/raw/*.sbn
data/raw/*.sbx

# Formatos tabulares grandes
*.parquet
*.feather
*.arrow
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/grid/*.parquet  # Permitir subir las rejillas base geoespaciales a GitHub

# ─── Datasets maestros de entrenamiento — PROHIBIDO SUBIRLOS ─────────────────
# Regla estricta del equipo: los dataset_maestro_YYYY.parquet (2019-2024) son
# ~2,4 GB en total y NUNCA deben entrar en el repositorio. Se distribuyen fuera
# de Git y cada persona los coloca en su DATA_ROOT local (ver .env.example).
data/raw/dataset_maestro/
data/raw/dataset_maestro/**
dataset_maestro_*.parquet
dataset_maestro_*.csv
**/dataset_maestro_*.parquet

# Otras carpetas de datos usadas históricamente por el equipo
Datos/
misc/Dataset/
data/interim/
data/external/*.parquet

# ─── Modelos serializados (pueden ser pesados) ────────────────────────────────
data/models/*
!data/models/.gitkeep
*.pkl
*.pickle

# ─── Outputs y artefactos temporales ─────────────────────────────────────────
outputs/
output/
figures/
reports/
*.html
*.pdf
!docs/*.pdf
!docs/references/*.pdf
!docs/references/*.html
!docs/references/*.ipynb

# ─── Streamlit ────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ─── Sistema operativo ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

misc/
tmp/

# Modelos serializados: un Random Forest son ~80 MB
*.joblib
/models/

# Detalle por corrida: reproducible relanzando el experimento.
# Lo que se versiona es docs/technical/resultados.csv, la bitacora acumulativa.
docs/technical/corridas/

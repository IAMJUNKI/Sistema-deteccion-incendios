# Copernicus Climate Data Store: token personal de https://cds.climate.copernicus.eu/profile
COPERNICUS_CDS_API_KEY=your_personal_access_token
COPERNICUS_CDS_API_URL=https://cds.climate.copernicus.eu/api

# Rutas locales (no se suben a Git)
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed

# Contrato del datacubo EGIF
TARGET_SOURCE=EGIF-MITECO
METEOROLOGY_SOURCE=Copernicus ERA5-Land
METEOROLOGY_CONTEXT_START=2018-12-01
DATACUBE_START=2019-01-01
DATACUBE_END=2023-11-23
GRID_RESOLUTION_M=1000

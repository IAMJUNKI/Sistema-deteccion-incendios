# =============================================================================
# .env.example — Variables de entorno necesarias para el proyecto
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env en la raíz del proyecto:
#      cp .env.example .env
#   2. Rellena los valores con tus claves reales.
#   3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
# =============================================================================

# ─── NASA FIRMS — Fire Information for Resource Management System ─────────────
# Obtener en: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# ─── Copernicus Climate Data Store (CDS) — ERA5-Land ────────────────────────
# Obtener en: https://cds.climate.copernicus.eu/user/register
# El UID y la clave están en tu perfil: https://cds.climate.copernicus.eu/profile
COPERNICUS_CDS_UID=your_uid_here
COPERNICUS_CDS_API_KEY=your_api_key_here
COPERNICUS_CDS_API_URL=https://cds.climate.copernicus.eu/api

# ─── AEMET OpenData ───────────────────────────────────────────────────────────
# Obtener en: https://opendata.aemet.es/centrodedescargas/altaUsuarios
# (Necesario para el pipeline de inferencia diaria en producción - Fase 5)
AEMET_API_KEY=your_aemet_api_key_here

# ─── Copernicus Dataspace (para Sentinel / Copernicus DEM) ───────────────────
# Obtener en: https://dataspace.copernicus.eu/
COPERNICUS_DATASPACE_USER=your_email_here
COPERNICUS_DATASPACE_PASSWORD=your_password_here

# ─── Configuración del Proyecto ───────────────────────────────────────────────
# Comunidad Autónoma del MVP (código INE o nombre)
MVP_REGION=galicia

# Rango de años históricos para entrenamiento
TRAIN_START_YEAR=2019
TRAIN_END_YEAR=2021
VAL_YEAR=2022
TEST_START_YEAR=2023
TEST_END_YEAR=2024

# Resolución de la rejilla (km)
GRID_RESOLUTION_KM=1

# ─── Rutas locales de datos ───────────────────────────────────────────────────
# Directorio base donde se almacenan los datos descargados
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_MODELS_PATH=data/models

# Copernicus Climate Data Store: token personal de https://cds.climate.copernicus.eu/profile
COPERNICUS_CDS_API_KEY=your_personal_access_token
COPERNICUS_CDS_API_URL=https://cds.climate.copernicus.eu/api

# Rutas locales (no se suben a Git)
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed

# Contrato del datacubo EGIF
TARGET_SOURCE=EGIF-MITECO
METEOROLOGY_SOURCE=Copernicus ERA5-Land
METEOROLOGY_CONTEXT_START=2018-12-01
DATACUBE_START=2019-01-01
DATACUBE_END=2023-11-26
GRID_RESOLUTION_M=1000
# ─── Proveedor meteorológico operativo ──────────────────────────────────────
# auto: WRF 1 km → WRF 04 km → AEMET degradado → stale (si se permite).
# También se puede fijar explícitamente: meteogalicia o aemet.
FORECAST_PROVIDER=auto
FORECAST_AUTO_AEMET_FALLBACK=true

# ─── MeteoGalicia MeteoSIX v5 — forecast operativo WRF ─────────────────────
# Solicitar una clave privada en el portal de MeteoGalicia. Es la fuente
# preferida para producción por su malla WRF y su cobertura horaria.
METEOGALICIA_API_KEY=your_meteogalicia_api_key_here
METEOGALICIA_BASE_URL=https://servizos.meteogalicia.gal/apiv5
METEOGALICIA_MODEL=WRF
# Primera opción: WRF 1 km; fallback automático: WRF 04 km.
METEOGALICIA_GRIDS=1km,04km
# Resolución de muestreo de puntos consultados. La rejilla final sigue siendo 1 km.
# Usar 1.0 solo si el presupuesto de peticiones permite una consulta más densa.
METEOGALICIA_QUERY_RESOLUTION_KM=4.0
METEOGALICIA_AUTO_ADJUST_POSITION=true
METEOGALICIA_TIMEOUT_SECONDS=60
METEOGALICIA_MAX_RETRIES=3

# ─── AEMET OpenData — forecast y observación alternativa ───────────────────
# Solicitar la clave en https://opendata.aemet.es/centrodedescargas/altaUsuario
# AEMET consulta municipios, no una malla WRF. La lista siguiente usa las
# capitales provinciales como puntos representativos; amplíala para análisis
# espacial serio. La salida queda marcada como fresh_aemet o
# fresh_aemet_degraded si se activa mediante auto.
AEMET_API_KEY=your_aemet_api_key_here
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api
# En producción, preferir un fichero con todos los municipios gallegos
# configurados. Cada línea usa codigo:lat:lon; las cuatro capitales son solo
# un fallback de smoke tests cuando esta variable está vacía.
AEMET_MUNICIPALITIES_FILE=
AEMET_MUNICIPALITIES=15030:43.3623:-8.4115,27028:43.0097:-7.5568,32054:42.3367:-7.8639,36038:42.4310:-8.6440
AEMET_USE_HOURLY_OVERLAY=true
# La predicción diaria de AEMET puede no incluir mm de precipitación. Déjalo
# vacío por defecto: el pipeline fallará de forma explícita. Para pruebas
# técnicas solamente se puede usar 0, quedando el resultado como proxy.
AEMET_MISSING_PRECIPITATION_FALLBACK=
AEMET_TIMEOUT_SECONDS=60
AEMET_MAX_RETRIES=3
AEMET_MAX_SOURCE_DISTANCE_KM=80
# La climatología diaria AEMET está validada, pero se publica con retraso
# aproximado de cuatro días. Sirve para backfill y reconciliación histórica,
# no como única fuente de observaciones D-1 en producción.
AEMET_OBSERVATION_IDW_NEIGHBORS=4
AEMET_OBSERVATIONS_RAW_DIR=data/raw/aemet/observations
AEMET_HOURLY_OBSERVATIONS_PATH=data/processed/observations/aemet_hourly_observations.parquet
AEMET_CURRENT_MIN_COVERAGE_HOURS=20
AEMET_HOURLY_RETENTION_HOURS=72
AEMET_INGEST_LOCK_PATH=data/processed/.aemet_ingest.lock
WEATHER_OBSERVATIONS_PATH=data/processed/observations/weather_daily_latest.parquet
# Todos los productores que escriben weather_daily_state.parquet deben usar
# este mismo lock para evitar carreras entre MeteoGalicia y AEMET.
WEATHER_STATE_INGEST_LOCK_PATH=data/processed/.weather_state_ingest.lock
METEOGALICIA_OBSERVATIONS_PATH=data/processed/observations/weather_daily_meteogalicia.parquet
METEOGALICIA_OBSERVATIONS_RAW_DIR=data/raw/meteogalicia/observations
METEOGALICIA_INGEST_LOCK_PATH=data/processed/.weather_state_ingest.lock

# ─── Copernicus Dataspace (para Sentinel / Copernicus DEM) ───────────────────
COPERNICUS_DATASPACE_USER=your_email_here
COPERNICUS_DATASPACE_PASSWORD=your_password_here

# ─── Hugging Face Hub (Distribución de Modelos y Artefactos Operativos) ──────
# Repositorio público o privado (ej. tu-usuario/galicia-wildfire-risk)
HF_REPO_ID=your_username/galicia-wildfire-risk
# Token con permiso 'Write' para subir desde el servidor o local (en huggingface.co/settings/tokens)
HF_TOKEN=your_hf_write_token_here

# ─── Configuración del Proyecto ─────────────────────────────────────────────
PIPELINE_ENVIRONMENT=local
# Solo para demostraciones locales cuando no se ha mantenido el colector AEMET
# horario. No activarlo en servidores: la salida quedará marcada como simulada
# y el health check la rechazará como producción.
LOCAL_SIMULATION_MODE=false
# Último día de observaciones que se quiere tratar como disponible, por ejemplo:
# LOCAL_SIMULATION_AS_OF_DATE=2026-08-26
LOCAL_SIMULATION_AS_OF_DATE=
# Comunidad Autónoma del MVP (código INE o nombre)
MVP_REGION=galicia
# Rango de años históricos para entrenamiento
TRAIN_START_YEAR=2019
TRAIN_END_YEAR=2021
VAL_YEAR=2022
TEST_START_YEAR=2023
TEST_END_YEAR=2024
# Resolución de la rejilla (km)
GRID_RESOLUTION_KM=1

# ─── Rutas locales de datos ─────────────────────────────────────────────────
# Directorio base donde se almacenan los datos descargados
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_MODELS_PATH=data/models

# ─── Rutas y controles del pipeline operativo ───────────────────────────────
# Estado diario de observaciones/analisis hasta el ultimo dia completo.
WEATHER_STATE_PATH=data/processed/state/weather_daily_state.parquet
# Archivo de control para impedir dos inferencias simultaneas.
INFERENCE_LOCK_PATH=data/processed/.daily_inference.lock
INFERENCE_MANIFEST_PATH=data/processed/predicciones_operativas.manifest.json
INFERENCE_HISTORY_DAYS=30
# Distancia maxima entre una celda de 1 km y el punto WRF consultado.
FORECAST_MAX_SOURCE_DISTANCE_KM=10

# ─── Rutas que consume el dashboard ──────────────────────────────────────────
PREDICTIONS_OUTPUT_PATH=data/processed/predicciones_operativas.parquet
PREDICTIONS_MANIFEST_PATH=data/processed/predicciones_operativas.manifest.json
GRID_PATH=data/processed/grid/galicia_grid_1km_egif.parquet
MODEL_DIR=data/models
# ─── Modelo EGIF 2D y rejilla canónica ─────────────────────────────────────
# auto: prioriza los tres artefactos EGIF de 48 variables; si no, usa la familia
# EGIF histórica de 50 y finalmente el rollback legacy.
FORECAST_MODEL_FAMILY=auto
EGIF_DATASET_DIR=data/external/egif
CANONICAL_GRID_CELLS=29601
SHADOW_50_MODEL=false
SHADOW_LEGACY_MODEL=false
# La rejilla EGIF debe aportar cell_id, centroides/geometría y las variables
# estáticas del contrato canónico. Mantener la ruta antigua solo para rollback.
# GRID_PATH=data/processed/grid/galicia_grid_1km_egif.parquet

# Configuración local del operador.
# Copiar a deploy/deploy.env y editar. Este fichero no debe versionarse.
#
# El acceso servidor -> GitHub usa otra clave: la Deploy Key que vive en
# /srv/fire-risk/.ssh del servidor.

DEPLOY_HOST=fire-risk.example.org
DEPLOY_PORT=22
DEPLOY_USER=deploy
DEPLOY_PATH=/srv/fire-risk
DEPLOY_SERVICE_USER=fire-risk
DEPLOY_REMOTE_BASE=/srv/fire-risk/data

# Usar un tag o commit revisado. DEPLOY_BRANCH sólo es un fallback cómodo.
DEPLOY_REF=v0.3.0
DEPLOY_BRANCH=

# Clave máquina local -> servidor; no es la Deploy Key de GitHub.
DEPLOY_SSH_KEY=/Users/usuario/.ssh/fire-risk-server
DEPLOY_KNOWN_HOSTS=

# true exige tests y reinicia Streamlit mediante sudo -n del usuario remoto.
DEPLOY_RUN_TESTS=true
DEPLOY_RESTART_DASHBOARD=true
DEPLOY_RUN_CHECK=true
DEPLOY_REQUIRE_OUTPUT=false
DEPLOY_USE_SUDO=true
DEPLOY_DRY_RUN=false

# Como alternativa, utilizar un alias definido en ~/.ssh/config:
# DEPLOY_SSH_TARGET=fire-risk-prod

[Unit]
Description=Actualizar observaciones diarias de MeteoGalicia
After=network-online.target
Wants=network-online.target
Before=fire-risk-inference.service

[Service]
Type=oneshot
User=fire-risk
Group=fire-risk
WorkingDirectory=/srv/fire-risk/app
EnvironmentFile=/srv/fire-risk/config/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/srv/fire-risk/app
ExecStart=/opt/miniconda3/envs/incendios-forestales/bin/python scripts/ingest_meteogalicia_observations.py --auto-fill-gap --grid /srv/fire-risk/data/processed/grid/galicia_grid_1km_egif.parquet --observations /srv/fire-risk/data/processed/observations/weather_daily_meteogalicia.parquet --state /srv/fire-risk/data/processed/state/weather_daily_state.parquet --raw-dir /srv/fire-risk/data/raw/meteogalicia/observations --lock /srv/fire-risk/data/processed/.weather_state_ingest.lock
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/fire-risk/app
ReadWritePaths=/srv/fire-risk/data
TimeoutStartSec=15min
UMask=0027
